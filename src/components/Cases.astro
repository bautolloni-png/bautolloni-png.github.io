---
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { cases } = t;
---

<section id={t.ids.cases} class="border-b border-line py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={cases.eyebrow} title={cases.title} intro={cases.intro} />

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        cases.items.map((c) => (
          <article class:list={['card flex flex-col p-6 sm:p-8', c.featured && 'md:col-span-2']}>
            <p class="eyebrow">{c.kind}</p>
            <h3 class:list={['mt-3 font-semibold tracking-[-0.02em]', c.featured ? 'text-3xl md:text-4xl' : 'text-2xl']}>{c.title}</h3>

            <dl class:list={['mt-6 grid flex-1 gap-5', c.featured && 'md:grid-cols-3']}>
              {[
                [cases.labels.problem, c.problem],
                [cases.labels.built, c.built],
                [cases.labels.result, c.result],
              ].map(([label, text]) => (
                <div>
                  <dt class="font-mono text-xs tracking-wide text-muted uppercase">{label}</dt>
                  <dd class="mt-1.5 leading-relaxed text-ink-soft">{text}</dd>
                </div>
              ))}
            </dl>

            <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5">
              <ul class="flex flex-wrap gap-2">
                {c.tools.map((tool) => <li class="chip">{tool}</li>)}
              </ul>
              {c.link && (
                <a href={c.link.href} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 text-sm font-semibold">
                  {c.link.label}
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
