---
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { value } = t.recruiters;
---

<section class="border-b border-line py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={value.eyebrow} title={value.title} />

    <ul class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        value.items.map((item) => (
          <li class="card p-6 sm:p-8">
            <h3 class="flex items-start gap-2.5 text-xl font-semibold tracking-[-0.01em]">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 12 12" fill="none" class="mt-1 shrink-0 text-brand">
                <path d="M2.5 6.2 5 8.5l4.5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item.title}
            </h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
