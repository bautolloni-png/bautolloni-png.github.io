---
import ContactForm from './ContactForm.astro';
import SectionHeading from './SectionHeading.astro';
import type { Motivo } from '../lib/formulario';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
  title?: string;
  text?: string;
  emailSubject?: string;
  motive?: Motivo;
}

const { t, motive } = Astro.props;
const { contact } = t;
const title = Astro.props.title ?? contact.title;
const text = Astro.props.text ?? contact.text;
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(Astro.props.emailSubject ?? contact.emailSubject)}`;
---

<section id={t.ids.contact} class="dot-grid relative bg-mist py-24 md:py-32">
  <div class="container-page grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div>
      <SectionHeading eyebrow={contact.eyebrow} title={title} intro={text} />

      <p class="mt-10 text-ink-soft">{contact.orEmail}</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={mailto} class="btn btn-ghost">{contact.emailLabel}</a>
        <a href={contact.linkedin.href} target="_blank" rel="noopener" class="btn btn-ghost">{contact.linkedin.label}</a>
        <a href={t.hero.cv.href} download class="btn btn-ghost">{contact.cvLabel}</a>
      </div>

      <p class="mt-8 font-mono text-xs leading-relaxed text-muted">
        <a href={mailto} class="underline-offset-4 hover:text-ink hover:underline">{contact.email}</a>
        <br />
        {contact.meta}
      </p>
    </div>

    <ContactForm t={t} motive={motive} />
  </div>
</section>
