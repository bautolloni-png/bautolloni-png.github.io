---
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { process } = t;
---

<section class="border-b border-line py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={process.eyebrow} title={process.title} />

    <ol class="mt-12 grid gap-4 md:grid-cols-3">
      {
        process.steps.map((step, i) => (
          <li class="card relative p-6 sm:p-8">
            <span class="flex size-10 items-center justify-center rounded-full bg-brand font-mono text-sm text-on-brand">{i + 1}</span>
            <h3 class="mt-5 text-xl font-semibold tracking-[-0.01em]">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <ul class="mt-8 space-y-3">
      {
        process.notes.map((note) => (
          <li class="flex items-start gap-3 text-ink-soft">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 12 12" fill="none" class="mt-0.5 shrink-0 text-brand">
              <path d="M2.5 6.2 5 8.5l4.5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {note}
          </li>
        ))
      }
    </ul>
  </div>
</section>
