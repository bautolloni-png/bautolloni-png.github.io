---
// Los datos que un recruiter busca primero: disponibilidad, modalidad, idioma, contratación y puestos.
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { glance, roles, learning } = t.recruiters;
---

<section class="border-b border-line py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={glance.eyebrow} title={glance.title} />

    <dl class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        glance.items.map((item) => (
          <div class="bg-surface p-6">
            <dt class="eyebrow">{item.label}</dt>
            <dd class="mt-2 text-xl font-semibold tracking-[-0.01em]">{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-10">
      <p class="eyebrow">{roles.label}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {roles.items.map((role) => <li class="chip h-9 px-3.5 text-sm">{role}</li>)}
      </ul>
    </div>
    <p class="mt-4 text-sm text-muted">{roles.note}</p>

    <div class="mt-10">
      <p class="eyebrow">{learning.label}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {learning.items.map((item) => <li class="chip h-9 border-dashed px-3.5 text-sm">{item}</li>)}
      </ul>
    </div>
  </div>
</section>
