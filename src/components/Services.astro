---
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { services } = t;
---

<section id={t.ids.services} class="border-b border-line py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={services.eyebrow} title={services.title} intro={services.intro} />

    <ol class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        services.items.map((s, i) => (
          <li class="card flex flex-col p-6 transition-colors hover:border-line-strong sm:p-8">
            <span class="font-mono text-sm text-pass">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-2xl font-bold tracking-[-0.02em]">{s.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{s.text}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {s.tools.map((tool) => <li class="chip">{tool}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
