---
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { about } = t;
---

<section id={t.ids.about} class="border-b border-line py-20 md:py-28">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <div>
        <SectionHeading eyebrow={about.eyebrow} title={about.title} />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-soft">
          {about.paragraphs.map((p) => <p class="text-pretty">{p}</p>)}
        </div>
      </div>

      <!-- Reemplazar el monograma por una foto real cuando esté. -->
      <aside class="card flex aspect-[4/5] max-h-[30rem] w-full flex-col justify-between overflow-hidden p-6 lg:self-center">
        <div class="dot-grid -m-6 flex flex-1 items-center justify-center p-6">
          <span class="text-[5.5rem] font-bold tracking-[-0.06em] text-ink">{about.card.monogram}</span>
        </div>
        <div class="mt-6 flex items-center justify-between gap-3 border-t border-line pt-4 font-mono text-xs text-muted">
          <span>{about.card.place}</span>
          <span>{about.card.zone}</span>
        </div>
        <p class="mt-3 inline-flex items-center gap-2 text-sm font-medium">
          <span class="relative flex size-2.5">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-pass opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-pass"></span>
          </span>
          {about.card.status}
        </p>
      </aside>
    </div>

    <dl class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      {
        about.facts.map((f) => (
          <div class="bg-surface p-6">
            <dt class="sr-only">{f.label}</dt>
            <dd>
              <span class="block text-5xl font-bold tracking-[-0.04em]">{f.value}</span>
              <span class="mt-2 block text-ink-soft">{f.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
