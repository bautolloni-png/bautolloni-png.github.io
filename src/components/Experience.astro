---
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { experience } = t;
---

<section id={t.ids.experience} class="border-b border-line py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={experience.eyebrow} title={experience.title} />

    <ol class="relative mt-12 space-y-6 border-l border-line pl-6 sm:pl-10">
      {
        experience.items.map((job) => (
          <li class="relative">
            <span class="absolute top-8 -left-[calc(1.5rem+5px)] size-2.5 rounded-full bg-pass ring-4 ring-paper sm:-left-[calc(2.5rem+5px)]" aria-hidden="true" />
            <article class="card p-6 sm:p-8">
              <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-2xl font-bold tracking-[-0.02em]">{job.company}</h3>
                <span class="font-mono text-sm text-muted">{job.dates}</span>
              </header>
              <p class="mt-1 text-sm text-muted">{job.context}</p>
              <p class="mt-4 leading-relaxed text-ink-soft">{job.summary}</p>

              {/* Los cargos se dibujan como carriles sobre el mismo período: en Ranking Online son simultáneos. */}
              <ul class="mt-6 space-y-3">
                {job.roles.map((role) => (
                  <li>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
                      <span class="font-semibold">{role.title}</span>
                      <span class="font-mono text-xs text-muted">{role.dates}</span>
                    </div>
                    <div class="mt-2 h-2 rounded-full bg-paper" aria-hidden="true">
                      <div
                        class="h-full rounded-full bg-pass"
                        style={`margin-left:${role.start * 100}%;width:${(role.end - role.start) * 100}%`}
                      />
                    </div>
                  </li>
                ))}
              </ul>
              {job.parallelNote && <p class="mt-4 font-mono text-xs text-muted">{job.parallelNote}</p>}
            </article>
          </li>
        ))
      }
    </ol>

    <p class="mt-8 text-ink-soft">
      <span class="eyebrow mr-3">{experience.education.label}</span>
      {experience.education.text}
    </p>
  </div>
</section>
