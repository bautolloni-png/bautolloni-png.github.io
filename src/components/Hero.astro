---
import Accent from './Accent.astro';
import LeadFlow from './LeadFlow.astro';
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { hero } = t;
---

<section class="dot-grid relative overflow-hidden border-b border-line">
  <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-linear-to-b from-paper/0 to-paper" aria-hidden="true"></div>

  <div class="container-page relative grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
    <div>
      <p class="tag">{hero.eyebrow.join(' · ')}</p>

      <h1 class="mt-6 text-[clamp(2.6rem,7.2vw,5rem)] leading-[1.02] font-semibold tracking-[-0.045em]">
        <span class="sr-only">{hero.srTitle}</span>
        <span aria-hidden="true" class="rotator block min-h-[2.04em] text-balance" data-phrases={JSON.stringify(hero.phrases)}>
          <Accent text={hero.phrases[0]} />
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft text-pretty md:text-xl">{hero.lead}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`#${t.ids.contact}`} class="btn btn-primary">{hero.primary}</a>
        <a href={`#${t.ids.cases}`} class="btn btn-ghost">{hero.secondary}</a>
      </div>

      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
        <a href={hero.cv.href} download class="inline-flex items-center gap-1.5 font-medium text-ink underline-offset-4 hover:underline">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1.5v8m0 0L3.8 6.3M7 9.5l3.2-3.2M2 12.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {hero.cv.label} (PDF)
        </a>
        <span>
          {hero.recruiter}{' '}
          <a href={t.paths.recruiters} class="font-medium text-ink underline underline-offset-4">{hero.recruiterLink}</a>
        </span>
      </p>

      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Stack">
        {hero.chips.map((c) => <li class="chip">{c}</li>)}
      </ul>
    </div>

    <LeadFlow flow={hero.flow} />
  </div>
</section>

<script>
  // Rota el titular. La primera frase ya viene pintada desde el servidor, sin parpadeo.
  const el = document.querySelector<HTMLElement>('.rotator');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce && JSON.parse(el.dataset.phrases ?? '[]').length > 1) {
    const phrases: string[] = JSON.parse(el.dataset.phrases ?? '[]');
    let index = 0;

    const render = (text: string) => {
      const [before, after = ''] = text.split('|');
      const accent = document.createElement('span');
      accent.className = 'accent';
      accent.textContent = after;
      el.replaceChildren(document.createTextNode(before), accent);
    };

    setInterval(() => {
      if (document.hidden) return;
      index = (index + 1) % phrases.length;
      el.classList.add('is-leaving');
      setTimeout(() => {
        render(phrases[index]);
        el.classList.remove('is-leaving');
      }, 280);
    }, 3200);
  }
</script>

<style>
  .rotator {
    transition:
      opacity 280ms ease,
      transform 280ms ease;
  }

  .rotator.is-leaving {
    opacity: 0;
    transform: translateY(0.15em);
  }
</style>
