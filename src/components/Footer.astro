---
import type { Content } from '../i18n/es';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<footer class="bg-night py-10 text-white/70">
  <div class="container-page flex flex-wrap items-center justify-between gap-4 text-sm">
    <p>© {new Date().getFullYear()} {t.footer.rights}</p>
    <ul class="flex flex-wrap gap-5">
      <li><a href={t.paths.recruiters} class="hover:text-white">{t.footer.recruiters}</a></li>
      <li><a href={t.contact.linkedin.href} target="_blank" rel="noopener" class="hover:text-white">{t.contact.linkedin.label}</a></li>
      <li><a href={t.footer.portfolio.href} target="_blank" rel="noopener" class="hover:text-white">{t.footer.portfolio.label}</a></li>
      <li><a href="https://nesvir.com" target="_blank" rel="noopener" class="hover:text-white">Nesvir</a></li>
    </ul>
  </div>
</footer>
